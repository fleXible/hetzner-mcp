# Hetzner Cloud + DNS API
HETZNER_CLOUD_TOKEN=your-cloud-api-token-here

# Hetzner Robot API (dedicated servers)
HETZNER_ROBOT_USER=your-robot-username
HETZNER_ROBOT_PASSWORD=your-robot-password

# Safety mode: read_only (default) | read_write
HETZNER_MODE=read_only

# Tool groups to enable: comma-separated list of: cloud, dns, robot
# Defaults to all groups for which credentials are configured.
# Example: enable only DNS and Robot tools
# HETZNER_TOOLS=dns,robot
